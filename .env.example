# ──────────────────────────────────────────────────────────────
# .env.example — Variables de entorno requeridas por envios-app
# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────

# Identificador único de la réplica (app1, app2, app3)
INSTANCE_ID=app1

# Puerto interno de la aplicación (no publicado al host)
PORT=3000

# ── Conexión a PostgreSQL ──────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=enviosdb
DB_USER=enviosuser
DB_PASSWORD=REEMPLAZA_CON_TU_PASSWORD

# ── Credenciales de PostgreSQL (usadas por el servicio db) ────
POSTGRES_DB=enviosdb
POSTGRES_USER=enviosuser
POSTGRES_PASSWORD=REEMPLAZA_CON_TU_PASSWORD

# ── Simulación de demora para prueba de timeout ───────────────
# Activar: SIMULATE_DELAY=true  |  Desactivar: SIMULATE_DELAY=false
SIMULATE_DELAY=false
